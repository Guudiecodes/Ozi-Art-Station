# Optional on your own computer. Required on Vercel (see docs/VERCEL.md).
OWNER_EMAIL=jokesonyou146@gmail.com
# Any long random text. Needed to create the owner account on a live server.
SETUP_KEY=
# Any long random text. Encrypts payment keys. Keep it the same forever, or saved keys cannot be read.
APP_SECRET=
# The final public address of the site.
SITE_URL=
# Neon database (Vercel adds this when you connect Neon).
DATABASE_URL=
# Cloudflare R2 file storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Vercel Blob file storage (Vercel adds this when you connect Blob). Used when R2 is not set.
BLOB_READ_WRITE_TOKEN=
# Shortcut: used for both SETUP_KEY and APP_SECRET when those are empty.
SECRET_KEY=
